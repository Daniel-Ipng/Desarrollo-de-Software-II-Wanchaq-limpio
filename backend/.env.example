# Variables de entorno para EcoRutas Wanchaq
# El backend Node.js ya no es necesario. La app Flutter se conecta
# directamente a Supabase. Pon estas credenciales en lib/main.dart.

# URL de tu proyecto Supabase
# Ejemplo: https://abcdefghijklmnop.supabase.co
SUPABASE_URL=https://TU_PROYECTO.supabase.co

# Clave pública anónima (anon key) de tu proyecto Supabase
# Encuéntrala en: Supabase Dashboard > Settings > API
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
